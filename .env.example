# Copy to .env and adjust for your environment.

# App
APP_NAME=Creator OS
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Storage: leave unset for local SQLite, or point at Postgres in production.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/creator_os

# Set to true when serving over HTTPS (production behind a proxy)
COOKIE_SECURE=false

# Password hashing cost and login session lifetime
PBKDF2_ITERATIONS=260000
SESSION_TTL_DAYS=30

# Optional writing assistant. With no AI variables set, Creator OS uses a
# deterministic built-in offline writer and the app works with no network calls.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
